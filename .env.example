# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Payment Gateway (Razorpay) Credentials
RAZORPAY_KEY_ID="rzp_test_YourKeyIdHere"
RAZORPAY_KEY_SECRET="YourRazorpaySecretKeyHere"

# Telegram Community Invite Link (Configurable also in Admin Panel)
TELEGRAM_INVITE_LINK="https://t.me/+LocalConnectVIPClub"

# Admin Authentication
ADMIN_EMAIL="admin@localconnect.app"
ADMIN_PASSWORD="ChangeThisSecureAdminPassword2026!"

# Auth / Session Secret
SESSION_SECRET="super-secure-secret-key-32-chars-min"

